<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Standard handles are supplied by the MCP client; never allocate a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Deskweave.WorkspaceBridge</AssemblyName>
    <AssemblyTitle>Deskweave Workspace Bridge</AssemblyTitle>
    <Description>Connects a local agent's MCP standard streams to its Windows workspace pipe.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\WorkspacePipeProtocol.cs" Link="WorkspacePipeProtocol.cs" />
  </ItemGroup>
</Project>
