<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Standard handles are supplied by the MCP client; never allocate a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ARS.WorkspaceBridge</AssemblyName>
    <AssemblyTitle>ARS Workspace Bridge</AssemblyTitle>
    <Description>Connects a local agent's MCP standard streams to its Windows workspace pipe.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\WorkspacePipeProtocol.cs" Link="WorkspacePipeProtocol.cs" />
    <!-- The router's initialize and tools/list results, answered while ARS is away. Regenerate with
         the engine probe's bridge-offline-json mode (see engine/LIFECYCLE.md) after changing the tools or
         RouterInstructions; the engine probe fails while this copy differs from the router's replies. -->
    <EmbeddedResource Include="offline.json" LogicalName="offline.json" />
  </ItemGroup>
</Project>
