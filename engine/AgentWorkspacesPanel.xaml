<UserControl x:Class="HiveMind.AgentWorkspaces.AgentWorkspacesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HiveMind.AgentWorkspaces"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="False" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             automation:AutomationProperties.Name="Agent Workspaces visual shell">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HiveMind.AgentWorkspaces;component/Palette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="QuietAction" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="11,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.76"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>

            <Style x:Key="SetupAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
                <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="ReviewStateChoice" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellSelectedBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="WorkspaceNameText" FontSize="20" FontWeight="SemiBold"
                             Foreground="{DynamicResource ShellInkBrush}" Background="Transparent"
                             BorderThickness="0" Padding="0" CaretBrush="{DynamicResource ShellInkBrush}"
                             LostFocus="WorkspaceName_LostFocus" KeyDown="WorkspaceName_KeyDown"
                             automation:AutomationProperties.Name="Workspace name"/>
                    <Button x:Name="SwitchButton" Style="{StaticResource IconAction}" Margin="4,2,0,0"
                            VerticalAlignment="Center" Click="SwitchButton_Click"
                            ToolTip="Switch workspace, create or delete"
                            automation:AutomationProperties.Name="Switch workspace, create or delete">
                        <Path Data="M6,9 L12,15 L18,9" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource ShellIconBrush}" StrokeThickness="1.7"
                              StrokeLineJoin="Round"/>
                    </Button>
                    <Border x:Name="PreviewOnlyBadge" Margin="11,1,0,0" Padding="8,3" CornerRadius="7" Visibility="Collapsed"
                            Background="{DynamicResource ShellChipBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewBadgeText" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
                    <Ellipse x:Name="StateDot" Width="6" Height="6" Margin="0,0,7,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateLabelText" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource ShellTextBrush}"/>
                    <TextBlock x:Name="StateDetailText" FontSize="11.5" Margin="8,0,0,0"
                                Foreground="{DynamicResource ShellMutedBrush}"
                                TextTrimming="CharacterEllipsis"
                                automation:AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="StorageText" FontSize="11.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource ShellMutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PowerButton" Style="{StaticResource QuietAction}" Margin="0,0,8,0"
                        Content="Light" Click="PowerButton_Click"
                        automation:AutomationProperties.Name="Workspace power: Light. Click for Fast."/>
                <Button x:Name="StartButton" Style="{StaticResource QuietAction}" Margin="0,0,8,0"
                        Content="Start computer" Click="StartButton_Click"
                        automation:AutomationProperties.Name="Start this workspace computer"/>
                <Button x:Name="FullWindowButton" Style="{StaticResource QuietAction}"
                        Click="FullWindowButton_Click"
                        ToolTip="Open a separate full-size window"
                        automation:AutomationProperties.Name="Open workspace in a full-size window">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M5,5 H19 V19 H5 Z M12,5 H19 V12" Width="13" Height="13"
                              Stretch="Uniform" Stroke="{DynamicResource ShellIconBrush}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,7,0"/>
                        <TextBlock Text="Full window" FontSize="11.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition x:Name="ChatColumn" Width="286"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ScreenSurface" Background="{DynamicResource ShellChipBrush}"
                    CornerRadius="12" Padding="9" AllowDrop="True"
                    DragOver="ScreenSurface_DragOver" Drop="ScreenSurface_Drop"
                    automation:AutomationProperties.Name="Workspace screen. Drop files here to copy them into this workspace.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="Both"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid Width="960" Height="540">
                            <Image x:Name="LiveScreen" Visibility="Collapsed" Stretch="Uniform"
                                   Focusable="True" Cursor="Arrow"
                                   RenderOptions.BitmapScalingMode="LowQuality"
                                   MouseLeftButtonDown="LiveScreen_MouseDown"
                                   MouseRightButtonDown="LiveScreen_MouseDown"
                                   MouseWheel="LiveScreen_MouseWheel"
                                   TextInput="LiveScreen_TextInput"
                                   PreviewKeyDown="LiveScreen_KeyDown"
                                   automation:AutomationProperties.Name="Live workspace screen"/>
                        </Grid>
                    </Viewbox>
                    <!-- Placeholder copy stays at native text size. Only the live screen uses
                         the 960x540 coordinate surface required by its input adapters. -->
                    <local:WorkspaceFrame x:Name="ComputerFrame"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Grid Grid.Row="1" Margin="4,9,4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ControllerDot" Width="6" Height="6" Margin="0,0,7,0"
                                     Fill="{DynamicResource AWWorkingBrush}"/>
                            <TextBlock x:Name="ControllerText" Text="Agent has control" FontSize="11"
                                       Foreground="{DynamicResource ShellMutedBrush}"/>
                            <TextBlock x:Name="CurrentTaskText" FontSize="11" Margin="12,0,0,0"
                                       Foreground="{DynamicResource ShellTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="ControlButton" HorizontalAlignment="Right"
                                Style="{StaticResource QuietAction}" Padding="10,5"
                                Content="Take control" Click="ControlButton_Click"
                                automation:AutomationProperties.Name="Take control of workspace preview"/>
                    </Grid>
                </Grid>
            </Border>

            <Button x:Name="ChatToggleButton" Grid.Column="1" Style="{StaticResource IconAction}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Click="ChatToggleButton_Click" ToolTip="Collapse boss chat"
                    automation:AutomationProperties.Name="Collapse boss chat">
                <Path x:Name="ChatToggleGlyph" Data="M13,5 L6,12 L13,19"
                      Width="8" Height="12" Stretch="Uniform"
                      Stroke="{DynamicResource ShellIconBrush}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Button>

            <Border x:Name="ChatPanel" Grid.Column="2"
                    Background="{DynamicResource ShellPanelBrush}"
                    BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Boss agent" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ShellMutedBrush}"/>
                            <TextBlock x:Name="BossText" Text="Idle" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ShellTextBrush}"/>
                        </StackPanel>
                        <Button x:Name="AgentSettingsButton" Grid.Column="1"
                                Style="{StaticResource IconAction}" Width="26" Height="26" Padding="5"
                                Margin="0,0,5,0" VerticalAlignment="Center"
                                Click="AgentSettingsButton_Click" ToolTip="Boss agent settings"
                                automation:AutomationProperties.Name="Boss agent settings">
                            <Path Data="M2,4 L16,4 M2,9 L16,9 M2,14 L16,14 M6,1 L6,7 M12,6 L12,12 M8,11 L8,17"
                                  Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource ShellIconBrush}" StrokeThickness="1.45"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Ellipse x:Name="BossDot" Grid.Column="2" Width="7" Height="7"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Fill="{DynamicResource AWWaitingBrush}"/>

                        <Popup x:Name="AgentSettingsPopup"
                               PlacementTarget="{Binding ElementName=AgentSettingsButton}"
                               Placement="Bottom" HorizontalOffset="-236" VerticalOffset="5"
                               AllowsTransparency="True" StaysOpen="False"
                               Closed="AgentSettingsPopup_Closed">
                            <Border Width="270" Padding="14" CornerRadius="10"
                                    Background="{DynamicResource ShellPanelBrush}"
                                    BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Boss agent settings" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ShellTextBrush}"/>

                                    <TextBlock Text="Credentials" Margin="0,14,0,6" FontSize="9.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                        <RadioButton x:Name="SubscriptionCredentialsChoice"
                                                     Style="{StaticResource ReviewStateChoice}"
                                                     GroupName="AgentCredentials" Content="Subscription"
                                                     Checked="AgentSettingsChoice_Changed"
                                                     automation:AutomationProperties.Name="Use Claude subscription"/>
                                        <RadioButton x:Name="ConfiguredCredentialsChoice"
                                                     Style="{StaticResource ReviewStateChoice}"
                                                     GroupName="AgentCredentials" Content="CLI / API"
                                                     Checked="AgentSettingsChoice_Changed"
                                                     automation:AutomationProperties.Name="Use Claude CLI or API configuration"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CredentialsDetailText" Margin="1,6,0,0"
                                               FontSize="9.5" LineHeight="14" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ShellHintBrush}"/>
                                    <TextBlock x:Name="PlanUsageText" Margin="1,5,0,0"
                                               FontSize="9.5" LineHeight="14" TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               Foreground="{DynamicResource ShellMutedBrush}"
                                               automation:AutomationProperties.Name="Claude plan usage"/>

                                    <TextBlock Text="Per-run ceiling" Margin="0,14,0,6" FontSize="9.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource ShellMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                        <RadioButton x:Name="LimitedRunChoice"
                                                     Style="{StaticResource ReviewStateChoice}"
                                                     GroupName="RunCeiling" Content="Limit"
                                                     Checked="AgentSettingsChoice_Changed"
                                                     automation:AutomationProperties.Name="Limit each boss-agent run"/>
                                        <Border x:Name="RunCeilingInput" Margin="4,0,4,0" Padding="8,4"
                                                CornerRadius="7" Background="{DynamicResource ShellChipBrush}"
                                                BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock Text="M tokens" DockPanel.Dock="Right" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ShellMutedBrush}"/>
                                                <TextBox x:Name="RunCeilingBox" Width="48" BorderThickness="0"
                                                         Background="Transparent" VerticalContentAlignment="Center"
                                                         Foreground="{DynamicResource ShellTextBrush}"
                                                         CaretBrush="{DynamicResource ShellTextBrush}"
                                                         KeyDown="RunCeilingBox_KeyDown"
                                                         automation:AutomationProperties.Name="Per-run ceiling in millions of tokens"/>
                                            </DockPanel>
                                        </Border>
                                        <RadioButton x:Name="UnlimitedRunChoice"
                                                     Style="{StaticResource ReviewStateChoice}"
                                                     GroupName="RunCeiling" Content="No ceiling"
                                                     Checked="AgentSettingsChoice_Changed"
                                                     automation:AutomationProperties.Name="No per-run ceiling"/>
                                    </StackPanel>

                                    <TextBlock x:Name="AgentSettingsRunNote" Margin="1,10,0,0"
                                               FontSize="9.5" LineHeight="14" TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               Text="The agent is working. What you save here applies to its next run."
                                               Foreground="{DynamicResource ShellHintBrush}"/>

                                    <TextBlock x:Name="AgentSettingsErrorText" Margin="1,7,0,0"
                                               FontSize="9.5" TextWrapping="Wrap" Visibility="Collapsed"
                                               Foreground="{DynamicResource AWFailedBrush}"
                                               automation:AutomationProperties.LiveSetting="Polite"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                        <Button x:Name="CancelAgentSettingsButton"
                                                Style="{StaticResource QuietAction}" Content="Cancel" Padding="10,5"
                                                Margin="0,0,6,0" Click="CancelAgentSettings_Click"
                                                automation:AutomationProperties.Name="Cancel boss agent settings"/>
                                        <Button x:Name="SaveAgentSettingsButton"
                                                Style="{StaticResource SetupAction}" Content="Save" Padding="10,5"
                                                Click="SaveAgentSettings_Click"
                                                automation:AutomationProperties.Name="Save boss agent settings"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border x:Name="MissionCard" Grid.Row="1" Visibility="Collapsed" Margin="0,13,0,12" Padding="10,8" CornerRadius="8"
                            Background="{DynamicResource ShellChipBrush}">
                        <StackPanel>
                            <TextBlock Text="Current mission" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ShellMutedBrush}"/>
                            <TextBlock x:Name="MissionText"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ShellTextBrush}"/>
                            <TextBlock x:Name="UsageText"
                                       FontSize="9.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ShellMutedBrush}"
                                       automation:AutomationProperties.Name="Tokens used"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Transcript"/>
                        </ScrollViewer>

                        <StackPanel x:Name="AgentSetupPanel" Visibility="Collapsed"
                                    VerticalAlignment="Center" Margin="2,4"
                                    automation:AutomationProperties.LiveSetting="Polite">
                            <TextBlock x:Name="SetupHeadingText" Text="Set up the boss agent"
                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ShellTextBrush}"/>
                            <TextBlock x:Name="SetupDetailText" Margin="0,7,0,0" FontSize="10.5"
                                       LineHeight="16" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ShellMutedBrush}"/>
                            <ProgressBar x:Name="SetupProgress" Margin="0,13,0,0" Height="3"
                                         Minimum="0" Maximum="100" Visibility="Collapsed"
                                         Foreground="{DynamicResource ShellAccentBrush}"
                                         Background="{DynamicResource ShellBorderBrush}"
                                         automation:AutomationProperties.Name="Boss agent setup progress"/>
                            <Button x:Name="SetupActionButton" Style="{StaticResource SetupAction}"
                                    Margin="0,14,0,0" Content="Set up" Click="SetupActionButton_Click"
                                    automation:AutomationProperties.Name="Set up the boss agent"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Border Background="{DynamicResource ShellChipBrush}" CornerRadius="8" Padding="9,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MissionBox" FontSize="10.5" BorderThickness="0"
                                         Background="Transparent" AcceptsReturn="False"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Tell the boss agent what to do"
                                         KeyDown="MissionBox_KeyDown" TextChanged="MissionBox_TextChanged"
                                         Foreground="{DynamicResource ShellTextBrush}"
                                         CaretBrush="{DynamicResource ShellTextBrush}"/>
                                <TextBlock x:Name="MissionHint" Text="Tell the agent what to do…" FontSize="10.5"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource ShellHintBrush}"/>
                                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource IconAction}"
                                        Margin="6,0,0,0" Click="SendButton_Click" IsEnabled="False"
                                        AutomationProperties.Name="Send this to the boss agent">
                                    <Path x:Name="SendGlyph" Data="M4,12 L20,4 L14,20 L11,13 Z" Width="13" Height="13"
                                          Stretch="Uniform" Fill="{DynamicResource ShellMutedBrush}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <Button x:Name="ResumeMissionButton" Style="{StaticResource QuietAction}"
                                Margin="0,8,0,0" Padding="12,6" HorizontalAlignment="Left"
                                Visibility="Collapsed" Content="Resume this mission"
                                Click="ResumeMissionButton_Click"
                                automation:AutomationProperties.Name="Resume this interrupted mission"/>
                        <Button x:Name="StopMissionButton" Style="{StaticResource QuietAction}"
                                Margin="0,8,0,0" Padding="12,6" HorizontalAlignment="Left"
                                Visibility="Collapsed" Content="Stop this mission"
                                Click="StopMissionButton_Click"
                                automation:AutomationProperties.Name="Stop the running mission"/>
                        <TextBlock x:Name="ChatHintText" Text="Start the computer first." FontSize="9.5" Margin="1,5,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ShellHintBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2">
            <Expander x:Name="CommandExpander" Margin="2,0,2,8" Visibility="Collapsed"
                      Foreground="{DynamicResource ShellTextBrush}"
                      automation:AutomationProperties.Name="Workspace command jobs">
                <Expander.Header>
                    <TextBlock x:Name="CommandSummaryText" Text="Commands" FontSize="12"
                               automation:AutomationProperties.LiveSetting="Polite"/>
                </Expander.Header>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="20,8,0,0">
                    <StackPanel x:Name="CommandList"/>
                </ScrollViewer>
            </Expander>
            <Expander x:Name="AccessExpander" Margin="2,0,2,8" Expanded="AccessExpander_Expanded"
                      Foreground="{DynamicResource ShellTextBrush}"
                      automation:AutomationProperties.Name="Agents and desktop requests">
                <Expander.Header>
                    <TextBlock x:Name="AccessSummaryText" Text="Agents · Just me" FontSize="12"/>
                </Expander.Header>
                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="20,8,0,0">
                    <StackPanel>
                        <StackPanel x:Name="DesktopRequestList" Margin="0,0,0,12"/>
                        <WrapPanel Margin="-2,0,0,0">
                            <RadioButton x:Name="AgentsJustMe" GroupName="WorkspaceAgents" Tag="" Style="{StaticResource ReviewStateChoice}"
                                         Content="Just me" Click="AgentsChoice_Click"
                                         automation:AutomationProperties.Name="No outside agents in this workspace"/>
                            <RadioButton x:Name="AgentsAnyone" GroupName="WorkspaceAgents" Tag="*" Style="{StaticResource ReviewStateChoice}"
                                         Content="Any agent" Click="AgentsChoice_Click"
                                         automation:AutomationProperties.Name="Any connected agent can work in this workspace"/>
                            <RadioButton x:Name="AgentsFolder" GroupName="WorkspaceAgents" Tag="folder" Style="{StaticResource ReviewStateChoice}"
                                         Content="A folder…" Click="AgentsChoice_Click"
                                         automation:AutomationProperties.Name="Agents working in a chosen folder use this workspace"/>
                            <RadioButton x:Name="AgentsClaude" GroupName="WorkspaceAgents" Tag="agent:claudecode" Style="{StaticResource ReviewStateChoice}"
                                         Content="Claude Code" Click="AgentsChoice_Click"
                                         automation:AutomationProperties.Name="Only Claude Code works in this workspace"/>
                            <RadioButton x:Name="AgentsCodex" GroupName="WorkspaceAgents" Tag="agent:codex" Style="{StaticResource ReviewStateChoice}"
                                         Content="Codex" Click="AgentsChoice_Click"
                                         automation:AutomationProperties.Name="Only Codex works in this workspace"/>
                        </WrapPanel>
                        <TextBlock Text="Agents can use files on your PC with your normal Windows permissions when the task calls for it. One agent controls this workspace at a time; your keyboard and mouse stay on your desktop."
                                   automation:AutomationProperties.AutomationId="WorkspaceFileAccessDescription"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,7,0,12" MaxWidth="690" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource ShellMutedBrush}"/>
                        <CheckBox x:Name="WebContentBlockingChoice" Margin="0,5,0,0"
                                  Foreground="{DynamicResource ShellTextBrush}"
                                  Checked="WebContentBlockingChoice_Click" Unchecked="WebContentBlockingChoice_Click"
                                  automation:AutomationProperties.AutomationId="WorkspaceWebContentBlocking"
                                  automation:AutomationProperties.Name="Block commands after browser inspection">
                            <TextBlock Text="Block commands after browser inspection (recommended)" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock x:Name="WebContentBlockingStateText" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                   MaxWidth="690" HorizontalAlignment="Left" Foreground="{DynamicResource ShellTextBrush}"
                                   automation:AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="Applies to the boss and connected agents in this workspace. Changes take effect immediately; already-started work is not stopped. Turning this off does not change desktop approval or owner takeover."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" MaxWidth="690" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource ShellMutedBrush}"/>
                        <CheckBox x:Name="PrewarmBrowserChoice" Margin="0,3,0,0"
                                  Foreground="{DynamicResource ShellTextBrush}"
                                  Checked="PrewarmBrowserChoice_Click" Unchecked="PrewarmBrowserChoice_Click"
                                  automation:AutomationProperties.AutomationId="WorkspacePrewarmBrowser"
                                  automation:AutomationProperties.Name="Start this workspace's browser with the workspace">
                            <TextBlock Text="Start this workspace's browser with the workspace" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock Text="On: the browser is ready before an agent asks for it, instead of costing about forty seconds on first use. It opens no page and reads nothing. Off: it starts on the first browse."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" MaxWidth="690" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource ShellMutedBrush}"/>
                        <CheckBox x:Name="DesktopRequestsChoice" Content="Ask me before opening finished files or links on my main desktop"
                                  Foreground="{DynamicResource ShellTextBrush}" Checked="DesktopRequestsChoice_Click" Unchecked="DesktopRequestsChoice_Click" Margin="0,3,0,0"
                                  automation:AutomationProperties.Name="Allow requests to open results on my main desktop"/>
                        <TextBlock Text="Unchecked: agents cannot request opening results on your main desktop. This does not limit file access. Requests never approve logins, payments or system permissions. Apps and scripts cannot be handed off."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="690" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource ShellMutedBrush}"/>
                        <TextBlock x:Name="AccessDetailText" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource ShellTextBrush}"
                                   automation:AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <Expander x:Name="PeekExpander" Margin="2,0,2,8"
                      Foreground="{DynamicResource ShellTextBrush}"
                      automation:AutomationProperties.Name="Corner view on your own screen">
                <Expander.Header>
                    <TextBlock x:Name="PeekSummaryText" Text="Corner view · Off" FontSize="12"/>
                </Expander.Header>
                <StackPanel Margin="20,8,0,0">
                    <TextBlock Text="A small live picture of whichever workspace is working, in a corner of your own screen, over whatever else you are doing. It never takes your keyboard or your mouse. Drag its top strip to move it, and click the picture to open that workspace here."
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9" MaxWidth="690"
                               HorizontalAlignment="Left" Foreground="{DynamicResource ShellMutedBrush}"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PeekOffChoice" GroupName="CornerView" Tag="Off"
                                     Style="{StaticResource ReviewStateChoice}" Content="Off"
                                     Checked="PeekMode_Checked"
                                     automation:AutomationProperties.Name="Corner view off"/>
                        <RadioButton x:Name="PeekActivityChoice" GroupName="CornerView" Tag="Activity"
                                     Style="{StaticResource ReviewStateChoice}" Content="While it works"
                                     Checked="PeekMode_Checked"
                                     automation:AutomationProperties.Name="Corner view while the workspace works"/>
                        <RadioButton x:Name="PeekAlwaysChoice" GroupName="CornerView" Tag="Always"
                                     Style="{StaticResource ReviewStateChoice}" Content="Always"
                                     Checked="PeekMode_Checked"
                                     automation:AutomationProperties.Name="Corner view always"/>
                    </StackPanel>
                    <TextBlock x:Name="PeekModeNote" FontSize="11" TextWrapping="Wrap" Margin="3,7,0,0"
                               MaxWidth="690" HorizontalAlignment="Left"
                               Foreground="{DynamicResource ShellMutedBrush}"
                               automation:AutomationProperties.LiveSetting="Polite"/>

                    <TextBlock Text="Corner" Margin="3,13,0,5" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource ShellMutedBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PeekBottomRightChoice" GroupName="CornerViewCorner" Tag="BottomRight"
                                     Style="{StaticResource ReviewStateChoice}" Content="Bottom right"
                                     Checked="PeekCorner_Checked"
                                     automation:AutomationProperties.Name="Bottom right corner"/>
                        <RadioButton x:Name="PeekBottomLeftChoice" GroupName="CornerViewCorner" Tag="BottomLeft"
                                     Style="{StaticResource ReviewStateChoice}" Content="Bottom left"
                                     Checked="PeekCorner_Checked"
                                     automation:AutomationProperties.Name="Bottom left corner"/>
                        <RadioButton x:Name="PeekTopRightChoice" GroupName="CornerViewCorner" Tag="TopRight"
                                     Style="{StaticResource ReviewStateChoice}" Content="Top right"
                                     Checked="PeekCorner_Checked"
                                     automation:AutomationProperties.Name="Top right corner"/>
                        <RadioButton x:Name="PeekTopLeftChoice" GroupName="CornerViewCorner" Tag="TopLeft"
                                     Style="{StaticResource ReviewStateChoice}" Content="Top left"
                                     Checked="PeekCorner_Checked"
                                     automation:AutomationProperties.Name="Top left corner"/>
                    </StackPanel>

                    <TextBlock Text="Shortcut" Margin="3,13,0,5" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource ShellMutedBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PeekHotkeyButton" Style="{StaticResource QuietAction}" Padding="11,5"
                                Content="Ctrl+Alt+W" Click="PeekHotkey_Click"
                                PreviewKeyDown="PeekHotkey_KeyDown" LostFocus="PeekHotkey_LostFocus"
                                automation:AutomationProperties.Name="Change the corner view shortcut"/>
                        <Button x:Name="PeekHotkeyClearButton" Style="{StaticResource QuietAction}" Padding="11,5"
                                Margin="7,0,0,0" Content="No shortcut" Click="PeekHotkeyClear_Click"
                                automation:AutomationProperties.Name="Use no shortcut for the corner view"/>
                    </StackPanel>
                    <TextBlock x:Name="PeekHotkeyNote" FontSize="11" TextWrapping="Wrap" Margin="3,7,0,0"
                               MaxWidth="690" HorizontalAlignment="Left"
                               Foreground="{DynamicResource ShellMutedBrush}"
                               automation:AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Expander>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenTerminalButton" Style="{StaticResource QuietAction}" Padding="9,4"
                            Margin="0,0,6,0" Content="Terminal" Tag="powershell.exe" Click="OpenApp_Click"
                            automation:AutomationProperties.Name="Open a terminal in the workspace"/>
                    <Button x:Name="OpenNotepadButton" Style="{StaticResource QuietAction}" Padding="9,4"
                            Margin="0,0,6,0" Content="Notepad" Tag="notepad.exe" Click="OpenApp_Click"
                            automation:AutomationProperties.Name="Open Notepad in the workspace"/>
                    <Button x:Name="OpenFilesButton" Style="{StaticResource QuietAction}" Padding="9,4"
                            Content="Files" Tag="explorer.exe" Click="OpenApp_Click"
                            automation:AutomationProperties.Name="Open a file window in the workspace"/>
                </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
