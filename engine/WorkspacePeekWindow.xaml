<Window x:Class="HiveMind.AgentWorkspaces.WorkspacePeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" Opacity="0"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True" Title="Workspace corner view"
        automation:AutomationProperties.Name="Workspace corner view">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HiveMind.AgentWorkspaces;component/Palette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The corner view has its own small chrome. The panel's buttons are sized for a page
                 and would take half the header. -->
            <Style x:Key="PeekIcon" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background"
                                            Value="{DynamicResource ShellHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource ShellPanelBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Transparent rather than unset: a Grid with no brush has nothing to hit, and the
                 header is what the owner drags the whole thing by. -->
            <Grid x:Name="Header" Background="Transparent" Margin="9,0,4,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot" Width="6" Height="6" Margin="0,0,7,0"
                             VerticalAlignment="Center" Fill="{DynamicResource AWIdleBrush}"/>
                    <TextBlock x:Name="NameText" FontSize="11" FontWeight="SemiBold" MaxWidth="150"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ShellTextBrush}"/>
                    <TextBlock x:Name="DoingText" FontSize="10.5" Margin="7,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ShellMutedBrush}"
                               automation:AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Style="{StaticResource PeekIcon}" Click="PinButton_Click"
                            ToolTip="Keep this on screen"
                            automation:AutomationProperties.Name="Keep the corner view on screen">
                        <Path x:Name="PinGlyph" Data="M12,4 L12,20 M6,10 L18,10" Width="12" Height="12"
                              Stretch="Uniform" Stroke="{DynamicResource ShellIconBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="OpenButton" Style="{StaticResource PeekIcon}" Click="OpenButton_Click"
                            ToolTip="Open this workspace in Deskweave"
                            automation:AutomationProperties.Name="Open this workspace in Deskweave">
                        <Path Data="M5,5 H19 V19 H5 Z M12,5 H19 V12" Width="12" Height="12"
                              Stretch="Uniform" Stroke="{DynamicResource ShellIconBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="HideButton" Style="{StaticResource PeekIcon}" Click="HideButton_Click"
                            ToolTip="Hide it for now"
                            automation:AutomationProperties.Name="Hide the corner view">
                        <Path Data="M6,6 L18,18 M18,6 L6,18" Width="11" Height="11"
                              Stretch="Uniform" Stroke="{DynamicResource ShellIconBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="1,0,1,1" CornerRadius="0,0,9,9" ClipToBounds="True"
                    Background="{DynamicResource ShellChipBrush}">
                <Grid>
                    <TextBlock x:Name="WaitingText" Text="Waiting for a picture"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource ShellMutedBrush}"/>
                    <!-- A glance, not a control surface: clicking it opens the workspace where the
                         owner can actually take control. Nothing here drives the agent's desktop. -->
                    <Image x:Name="LiveScreen" Stretch="Uniform" Visibility="Collapsed"
                           Cursor="Hand" RenderOptions.BitmapScalingMode="LowQuality"
                           MouseLeftButtonUp="LiveScreen_MouseLeftButtonUp"
                           automation:AutomationProperties.Name="Live workspace screen"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
