<Window x:Class="HiveMind.AgentWorkspaces.WorkspacePeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" Opacity="0"
        ShowActivated="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True" Title="Workspace corner view" AllowDrop="True"
        automation:AutomationProperties.Name="Workspace corner view">
    <Window.Resources>
        <!-- The hover actions and the grip live on glass, not on the app's own chrome: a small
             round button of their own rather than the title-bar IconButton. -->
        <Style x:Key="GlassAction" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassActionIcon" TargetType="Path" BasedOn="{StaticResource Icon13}">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style x:Key="ResizeEdge" TargetType="Rectangle">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- The back card of a two-up stack: a plain, non-interactive replica, smaller and higher. -->
        <Border x:Name="BackCard" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource CornerWindowRadius}" Opacity="0.92"
                Cursor="Hand" MouseLeftButtonDown="BackCard_MouseLeftButtonDown"
                automation:AutomationProperties.Name="Bring this workspace to the front">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.18" BlurRadius="24" ShadowDepth="10" Direction="270"/>
            </Border.Effect>
            <Grid x:Name="BackBody" ClipToBounds="True">
                <Image x:Name="BackScreen" Stretch="UniformToFill"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                        Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PillRadius}" Padding="9,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BackDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="BackName" FontSize="12" FontWeight="SemiBold" MaxWidth="120"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock x:Name="BackWho" FontSize="11.5" Margin="7,0,0,0" MaxWidth="120"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MutedInkBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- The card itself. Photographed without its shadow margin, so the shadow lives outside
             the card's own Width/Height rather than inside it. -->
        <Border x:Name="FrontCard" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource CornerWindowRadius}"
                MouseEnter="FrontCard_MouseEnter" MouseLeave="FrontCard_MouseLeave">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="{DynamicResource CornerShadowOpacity}" BlurRadius="60" ShadowDepth="24" Direction="270"/>
            </Border.Effect>
            <Grid x:Name="CardBody" ClipToBounds="True">
                <!-- The live picture. A glance, not a control surface of its own: clicks land through
                     WorkspaceScreenInput, never move the owner's own pointer onto the agent's desktop. -->
                <Image x:Name="LiveScreen" Stretch="UniformToFill" Cursor="Hand"
                       automation:AutomationProperties.Name="Live workspace screen"/>

                <!-- Activity line: a slow sweep while the agent works, static with animations off. -->
                <Rectangle x:Name="ActivityLine" Height="2" VerticalAlignment="Bottom" Visibility="Collapsed"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="ActivityBrush" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0.2"/>
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/>
                            <GradientStop Color="#00000000" Offset="0.8"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Drop target overlay: shown only while a file is dragged over the card. -->
                <Grid x:Name="DropOverlay" Visibility="Collapsed" Margin="6" IsHitTestVisible="False">
                    <Rectangle RadiusX="9" RadiusY="9" Fill="{DynamicResource AccentSoftBrush}"
                               Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="4,3"/>
                    <TextBlock x:Name="DropText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                </Grid>

                <!-- The glass pill: status dot, workspace name, agent. Shifts right on hover to clear
                     the resize grip. Dragging it moves the whole window. -->
                <Border x:Name="Pill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                        Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PillRadius}" Padding="9,4"
                        Cursor="SizeAll" MouseLeftButtonDown="Pill_MouseLeftButtonDown">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="3" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="NameText" FontSize="12" FontWeight="SemiBold" MaxWidth="160"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock x:Name="WhoText" FontSize="11.5" Margin="7,0,0,0" MaxWidth="220"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   automation:AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <!-- Resize grip: purely a hover affordance: the edges below resize whether or not the
                     card is hovered. -->
                <Path x:Name="Grip" Data="{StaticResource Icon.Grip}" Width="18" Height="18" Stretch="Uniform"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{DynamicResource FaintInkBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- Hover actions: pin, shrink (only once grown), open in hub, hide. -->
                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource GlassAction}"/>
                    </StackPanel.Resources>
                    <Button x:Name="PinButton" Margin="0,0,5,0" Click="PinButton_Click" ToolTip="Keep this on screen"
                            automation:AutomationProperties.Name="Keep the corner view on screen">
                        <Path x:Name="PinGlyph" Style="{StaticResource GlassActionIcon}" Data="{StaticResource Icon.Pin}"/>
                    </Button>
                    <Button x:Name="ShrinkButton" Margin="0,0,5,0" Click="ShrinkButton_Click" ToolTip="Shrink to small"
                            Visibility="Collapsed" automation:AutomationProperties.Name="Shrink the corner view to small">
                        <Path x:Name="ShrinkGlyph" Style="{StaticResource GlassActionIcon}" Data="{StaticResource Icon.Shrink}"/>
                    </Button>
                    <Button x:Name="OpenButton" Margin="0,0,5,0" Click="OpenButton_Click" ToolTip="Open this workspace"
                            automation:AutomationProperties.Name="Open this workspace">
                        <Path Style="{StaticResource GlassActionIcon}" Data="{StaticResource Icon.Open}"/>
                    </Button>
                    <Button x:Name="HideButton" Click="HideButton_Click" ToolTip="Hide it for now"
                            automation:AutomationProperties.Name="Hide the corner view">
                        <Path Style="{StaticResource GlassActionIcon}" Data="{StaticResource Icon.Close}"/>
                    </Button>
                </StackPanel>

                <!-- Result chip: the newest file the agent saved, draggable out to Explorer or the desktop. -->
                <Border x:Name="Chip" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="8,0,0,9" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PillRadius}" Padding="7,4,9,4"
                        Cursor="Hand" MouseMove="Chip_MouseMove"
                        automation:AutomationProperties.Name="Drag the newest saved file out">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon13}" Data="{StaticResource Icon.File}" Margin="0,0,6,0"
                              TextElement.Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="ChipText" FontSize="12" VerticalAlignment="Center" MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Needs-you sheet: a real question with real actions. Stays until answered. -->
                <Border x:Name="Sheet" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                        Margin="8" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="SheetQuestion" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Padding="14,5" Click="SheetOpen_Click"
                                    Content="Open"/>
                            <Button Style="{StaticResource DeskButton}" Padding="14,5" Margin="8,0,0,0"
                                    Click="SheetKeep_Click" Content="Keep here"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The one fixed color the reference itself fixes: the dark toast, both themes. -->
                <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,10" Background="#15181D" CornerRadius="7" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastText" FontSize="12" Foreground="White"/>
                        <TextBlock x:Name="ToastLink" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                   Margin="6,0,0,0" TextDecorations="Underline" Cursor="Hand" Visibility="Collapsed"
                                   Text="Hand back" MouseLeftButtonDown="ToastLink_MouseLeftButtonDown"/>
                    </StackPanel>
                </Border>

                <!-- Resize hit zones: any edge, kept inside the card so a hovering pointer stays over
                     the picture rather than in the shadow's transparent margin. -->
                <Rectangle Style="{StaticResource ResizeEdge}" Width="6" HorizontalAlignment="Left" Cursor="SizeWE"
                           PreviewMouseLeftButtonDown="ResizeLeft_MouseLeftButtonDown"/>
                <Rectangle Style="{StaticResource ResizeEdge}" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                           PreviewMouseLeftButtonDown="ResizeRight_MouseLeftButtonDown"/>
                <Rectangle Style="{StaticResource ResizeEdge}" Height="6" VerticalAlignment="Top" Cursor="SizeNS"
                           PreviewMouseLeftButtonDown="ResizeTop_MouseLeftButtonDown"/>
                <Rectangle Style="{StaticResource ResizeEdge}" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS"
                           PreviewMouseLeftButtonDown="ResizeBottom_MouseLeftButtonDown"/>
                <Rectangle Style="{StaticResource ResizeEdge}" Width="10" Height="10" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Cursor="SizeNWSE"
                           PreviewMouseLeftButtonDown="ResizeBottomRight_MouseLeftButtonDown"/>
                <Rectangle Style="{StaticResource ResizeEdge}" Width="10" Height="10" HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" Cursor="SizeNESW"
                           PreviewMouseLeftButtonDown="ResizeBottomLeft_MouseLeftButtonDown"/>
                <Rectangle Style="{StaticResource ResizeEdge}" Width="10" Height="10" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Cursor="SizeNESW"
                           PreviewMouseLeftButtonDown="ResizeTopRight_MouseLeftButtonDown"/>
                <Rectangle Style="{StaticResource ResizeEdge}" Width="10" Height="10" HorizontalAlignment="Left"
                           VerticalAlignment="Top" Cursor="SizeNWSE"
                           PreviewMouseLeftButtonDown="ResizeTopLeft_MouseLeftButtonDown"/>
            </Grid>
        </Border>
    </Grid>
</Window>
