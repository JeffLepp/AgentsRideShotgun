<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The one icon family: 16 DIP grid, 1.5 stroke,
         round caps and joins, drawn in the current foreground. Use a Path with Style="{StaticResource Icon}"
         and Data="{StaticResource Icon.Pin}". Icon13 / Icon14 / Icon15 scale the whole drawing,
         stroke included, the way the reference's smaller icons do. Mark and Arrow are filled. -->
    <Geometry x:Key="Icon.Plus">M8,3 V13 M3,8 H13</Geometry>
    <Geometry x:Key="Icon.Gear">M10.3,8 A2.3,2.3 0 1 1 5.7,8 A2.3,2.3 0 1 1 10.3,8 Z M8,1.5 V3.5 M8,12.5 V14.5 M1.5,8 H3.5 M12.5,8 H14.5 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M3.4,12.6 L4.8,11.2 M11.2,4.8 L12.6,3.4</Geometry>
    <Geometry x:Key="Icon.Pin">M6,2 H10 L9.5,6 L12,8.5 H4 L6.5,6 Z M8,8.5 V14</Geometry>
    <Geometry x:Key="Icon.Open">M9.5,2.5 H13.5 V6.5 M13.5,2.5 L9,7 M6.5,13.5 H2.5 V9.5 M2.5,13.5 L7,9</Geometry>
    <!-- A window going out of its box: Open on my desktop. -->
    <Geometry x:Key="Icon.PopOut">M9,2.5 H13.5 V7 M13.5,2.5 L8,8 M11.5,9.5 V13.5 H2.5 V4.5 H6.5</Geometry>
    <Geometry x:Key="Icon.Shrink">M13.5,6.5 H9.5 V2.5 M9.5,6.5 L14,2 M2.5,9.5 H6.5 V13.5 M6.5,9.5 L2,14</Geometry>
    <Geometry x:Key="Icon.Close">M4,4 L12,12 M12,4 L4,12</Geometry>
    <Geometry x:Key="Icon.Min">M2,8 H14</Geometry>
    <Geometry x:Key="Icon.Max">M3.5,2.5 H12.5 A1,1 0 0 1 13.5,3.5 V12.5 A1,1 0 0 1 12.5,13.5 H3.5 A1,1 0 0 1 2.5,12.5 V3.5 A1,1 0 0 1 3.5,2.5 Z</Geometry>
    <Geometry x:Key="Icon.File">M4,1.5 H9 L12,4.5 V14.5 H4 Z M9,1.5 V4.5 H12</Geometry>
    <Geometry x:Key="Icon.Folder">M1.5,4.5 V12.5 H14.5 V5.5 H8 L6.5,4 H1.5 Z</Geometry>
    <Geometry x:Key="Icon.Hand">M5.5,8 V3.5 A1,1 0 0 1 7.5,3.5 V7 M7.5,6.5 V2.5 A1,1 0 0 1 9.5,2.5 V6.5 M9.5,6.5 V4 A1,1 0 0 1 11.5,4 V9.5 C11.5,12 9.9,14 7.5,14 C5.8,14 4.9,13.2 3.9,11.8 L2.3,9.4 A1,1 0 0 1 3.9,8.2 L5.5,10</Geometry>
    <!-- Three dots: draw with StrokeThickness 2.4. -->
    <Geometry x:Key="Icon.More">M3.5,8 H3.51 M8,8 H8.01 M12.5,8 H12.51</Geometry>
    <Geometry x:Key="Icon.Down">M4,6 L8,10 L12,6</Geometry>
    <Geometry x:Key="Icon.Back">M10,3.5 L5.5,8 L10,12.5</Geometry>
    <Geometry x:Key="Icon.Sliders">M2.5,4.5 H13.5 M2.5,11.5 H13.5 M7.2,4.5 A1.7,1.7 0 1 1 3.8,4.5 A1.7,1.7 0 1 1 7.2,4.5 Z M12.2,11.5 A1.7,1.7 0 1 1 8.8,11.5 A1.7,1.7 0 1 1 12.2,11.5 Z</Geometry>
    <Geometry x:Key="Icon.Agents">M8.2,6 A2.2,2.2 0 1 1 3.8,6 A2.2,2.2 0 1 1 8.2,6 Z M2,13.5 C2.6,11.5 4.2,10.5 6,10.5 C7.8,10.5 9.4,11.5 10,13.5 M13.3,5.5 A1.8,1.8 0 1 1 9.7,5.5 A1.8,1.8 0 1 1 13.3,5.5 Z M11.2,9.5 C12.8,9.5 14,10.4 14.5,12.1</Geometry>
    <Geometry x:Key="Icon.Globe">M14,8 A6,6 0 1 1 2,8 A6,6 0 1 1 14,8 Z M2,8 H14 M8,2 C10,4 10,12 8,14 M8,2 C6,4 6,12 8,14</Geometry>
    <Geometry x:Key="Icon.Pip">M3,3 H13 A1.5,1.5 0 0 1 14.5,4.5 V11.5 A1.5,1.5 0 0 1 13,13 H3 A1.5,1.5 0 0 1 1.5,11.5 V4.5 A1.5,1.5 0 0 1 3,3 Z M8.6,8 H11.9 A0.6,0.6 0 0 1 12.5,8.6 V10.4 A0.6,0.6 0 0 1 11.9,11 H8.6 A0.6,0.6 0 0 1 8,10.4 V8.6 A0.6,0.6 0 0 1 8.6,8 Z</Geometry>
    <Geometry x:Key="Icon.Bell">M4,11 V7 A4,4 0 0 1 12,7 V11 L13,12.5 H3 L4,11 Z M6.5,14 A1.5,1.5 0 0 0 9.5,14</Geometry>
    <Geometry x:Key="Icon.Clock">M14,8 A6,6 0 1 1 2,8 A6,6 0 1 1 14,8 Z M8,4.5 V8 L10.5,9.5</Geometry>
    <Geometry x:Key="Icon.Gauge">M2.5,11.5 A5.5,5.5 0 1 1 13.5,11.5 M8,11.5 L10.5,8</Geometry>
    <Geometry x:Key="Icon.Shield">M8,1.8 L13,3.8 V7.8 C13,11 10.8,13.2 8,14.2 C5.2,13.2 3,11 3,7.8 V3.8 Z</Geometry>
    <Geometry x:Key="Icon.Info">M14,8 A6,6 0 1 1 2,8 A6,6 0 1 1 14,8 Z M8,7.2 V11 M8,5 H8.01</Geometry>
    <Geometry x:Key="Icon.Lock">M5,7 H11 A1.5,1.5 0 0 1 12.5,8.5 V12.5 A1.5,1.5 0 0 1 11,14 H5 A1.5,1.5 0 0 1 3.5,12.5 V8.5 A1.5,1.5 0 0 1 5,7 Z M5.5,7 V5 A2.5,2.5 0 0 1 10.5,5 V7</Geometry>
    <!-- 18x18, filled with the accent: the app icon's two windows, yours
         behind as an outline, the agent's in front, with a gap between so they read apart. -->
    <CombinedGeometry x:Key="Icon.Mark" GeometryCombineMode="Union">
        <CombinedGeometry.Geometry1>
            <CombinedGeometry GeometryCombineMode="Exclude">
                <CombinedGeometry.Geometry1>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1><RectangleGeometry Rect="1,2,11,9" RadiusX="2" RadiusY="2"/></CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2><RectangleGeometry Rect="2.6,3.6,7.8,5.8" RadiusX="0.8" RadiusY="0.8"/></CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </CombinedGeometry.Geometry1>
                <CombinedGeometry.Geometry2><RectangleGeometry Rect="5,6,13,12" RadiusX="2.6" RadiusY="2.6"/></CombinedGeometry.Geometry2>
            </CombinedGeometry>
        </CombinedGeometry.Geometry1>
        <CombinedGeometry.Geometry2><RectangleGeometry Rect="6.2,7.2,10.8,8.8" RadiusX="2" RadiusY="2"/></CombinedGeometry.Geometry2>
    </CombinedGeometry>
    <!-- 14x18, filled: the agent's pointer drawn over a screen. -->
    <Geometry x:Key="Icon.Arrow">M1,1 L1,15 L4.8,11.4 L7.6,17 L9.8,16 L7,10.4 L12.4,10.4 Z</Geometry>
    <!-- 18x18: the resize grip. -->
    <Geometry x:Key="Icon.Grip">M4,12 L12,4 M4,8 L8,4</Geometry>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style x:Key="Icon15" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.9375" ScaleY="0.9375"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="Icon14" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.875" ScaleY="0.875"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="Icon13" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.8125" ScaleY="0.8125"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="Icon12" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.75" ScaleY="0.75"/></Setter.Value></Setter>
    </Style>
    <!-- Caption buttons: 10 DIP glyphs at stroke 1, like Windows 11's. -->
    <Style x:Key="CaptionIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.625" ScaleY="0.625"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="MarkIcon" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource Icon.Mark}"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
    </Style>
</ResourceDictionary>
