<Project>
  <PropertyGroup>
    <Company>Jefferson Kline</Company>
    <Product>Deskweave</Product>
    <Copyright>Copyright © 2026 Jefferson Kline</Copyright>
    <Version>0.3.0</Version>
    <!-- Derived, so Settings (which shows the assembly version) and the file properties never lag Version. -->
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Match($(Version), '^\d+\.\d+\.\d+').Value).0</FileVersion>
    <AssemblyVersion>$(FileVersion)</AssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
