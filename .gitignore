*.log

# Local experiments and throwaway checks.
/scratch/
/launch/

# Signing material and local secrets. Never committed.
*.pfx
*.p12
*.snk
*.pem
*.key
.env
.env.*
*.local.json

# Crash dumps and sandbox run output.
*.dmp
/sandbox-runs/
