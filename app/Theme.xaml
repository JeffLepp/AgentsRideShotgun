<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HiveMind.AgentWorkspaces;component/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Light values until AppearanceManager paints the chosen theme over them. Always bind
         colors with DynamicResource: the theme replaces these at run time. Token names and
         values are in design/MVP_SPEC.md and AppearanceManager.cs. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F1F3F6"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InkBrush" Color="#15181D"/>
    <SolidColorBrush x:Key="MutedInkBrush" Color="#5E6674"/>
    <SolidColorBrush x:Key="FaintInkBrush" Color="#8E96A3"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#17141E32"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#29141E32"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2E6BF6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2459D6"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2E6BF6"/>
    <SolidColorBrush x:Key="NeedsYouBrush" Color="#E09A2B"/>
    <SolidColorBrush x:Key="NeedsYouInkBrush" Color="#A8650A"/>
    <SolidColorBrush x:Key="NeedsYouSoftBrush" Color="#21E09A2B"/>
    <SolidColorBrush x:Key="AsleepBrush" Color="#B0B7C3"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#E0FAFBFD"/>
    <SolidColorBrush x:Key="GlassEdgeBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#8E96A3"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0F141E32"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#1A141E32"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#F1F3F6"/>
    <SolidColorBrush x:Key="PreviewBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerInkBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBE9E9"/>
    <Color x:Key="AccentColor">#2E6BF6</Color>
    <Color x:Key="NeedsYouColor">#E09A2B</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>
    <Color x:Key="AsleepColor">#B0B7C3</Color>

    <!-- Names the engine's pages still use. AppearanceManager keeps them equal to the tokens. -->
    <StaticResource x:Key="ShellSurfaceBrush" ResourceKey="WindowBrush"/>
    <StaticResource x:Key="ShellCanvasBrush" ResourceKey="WindowBrush"/>
    <StaticResource x:Key="ShellChromeBrush" ResourceKey="WindowBrush"/>
    <StaticResource x:Key="ShellPanelBrush" ResourceKey="CardBrush"/>
    <StaticResource x:Key="ShellChipBrush" ResourceKey="ChipBrush"/>
    <StaticResource x:Key="ShellHoverBrush" ResourceKey="HoverBrush"/>
    <StaticResource x:Key="ShellSelectedBrush" ResourceKey="AccentSoftBrush"/>
    <StaticResource x:Key="ShellBorderBrush" ResourceKey="HairlineBrush"/>
    <StaticResource x:Key="ShellDividerBrush" ResourceKey="HairlineBrush"/>
    <StaticResource x:Key="ShellTextBrush" ResourceKey="InkBrush"/>
    <StaticResource x:Key="ShellInkBrush" ResourceKey="InkBrush"/>
    <StaticResource x:Key="ShellMutedBrush" ResourceKey="MutedInkBrush"/>
    <StaticResource x:Key="ShellHintBrush" ResourceKey="MutedInkBrush"/>
    <StaticResource x:Key="ShellIconBrush" ResourceKey="MutedInkBrush"/>
    <StaticResource x:Key="ShellAccentBrush" ResourceKey="AccentBrush"/>
    <StaticResource x:Key="ShellAccentHoverBrush" ResourceKey="AccentHoverBrush"/>
    <StaticResource x:Key="ShellPreviewBrush" ResourceKey="PreviewBrush"/>
    <StaticResource x:Key="ShellPreviewOverlayBrush" ResourceKey="GlassBrush"/>
    <StaticResource x:Key="TDangerBrush" ResourceKey="DangerSoftBrush"/>
    <StaticResource x:Key="TDangerInkBrush" ResourceKey="DangerInkBrush"/>
    <StaticResource x:Key="AWWorkingBrush" ResourceKey="AccentBrush"/>
    <StaticResource x:Key="AWWaitingBrush" ResourceKey="NeedsYouBrush"/>
    <StaticResource x:Key="AWFailedBrush" ResourceKey="DangerBrush"/>
    <StaticResource x:Key="AWAccentBrush" ResourceKey="AccentBrush"/>
    <StaticResource x:Key="AWIdleBrush" ResourceKey="AsleepBrush"/>
    <StaticResource x:Key="TAccentColor" ResourceKey="AccentColor"/>
    <StaticResource x:Key="TLiveColor" ResourceKey="AccentColor"/>
    <StaticResource x:Key="THoneyColor" ResourceKey="NeedsYouColor"/>
    <StaticResource x:Key="TDangerColor" ResourceKey="DangerColor"/>
    <StaticResource x:Key="TDotOffColor" ResourceKey="AsleepColor"/>

    <!-- Radii (DIP): controls 6, windows 8, cards 10, pills 8, corner window 12. -->
    <CornerRadius x:Key="SkinControlRadius">6</CornerRadius>
    <CornerRadius x:Key="SkinPanelRadius">10</CornerRadius>
    <CornerRadius x:Key="SkinWindowRadius">8</CornerRadius>
    <CornerRadius x:Key="PillRadius">8</CornerRadius>
    <CornerRadius x:Key="CornerWindowRadius">12</CornerRadius>
    <!-- The corner window's one soft shadow (reference: 0 24 60 at 20%, 55% in dark). -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CornerShadowOpacity">0.2</sys:Double>
    <FontFamily x:Key="SkinFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource SkinFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
    </Style>

    <Style x:Key="KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource SkinControlRadius}" Margin="-3"/></ControlTemplate></Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary button (reference .btn): card fill, control border, 12 semibold, radius 6. -->
    <Style x:Key="DeskButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SkinControlRadius}"/>
                        <Border x:Name="Tint" Background="Transparent" CornerRadius="{DynamicResource SkinControlRadius}"/>
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DeskButton}"/>

    <!-- Primary (reference .btn.p): accent fill, no border. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DeskButton}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SkinControlRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>

    <!-- Borderless text or icon button: muted until hovered. -->
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource DeskButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- Title-bar and toolbar icon button (reference .tbtn): 32 square, radius 6, a Path icon inside. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Windows caption buttons: 46 x 40, square, no radius. Close turns red on hover. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}">
                    <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="#C42B1C"/>
                        <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#C94F4F"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,2"/>
    </Style>

    <!-- A row in either sidebar (reference .item): radius 8, selected = card fill with a hairline
         ring and a 1 DIP shadow. The ring is a real 1 DIP border, so padding is one less than the
         reference's 7/8 (workspaces) or 8/10 (Settings, SidebarNavItem). Use as RadioButtons in one
         GroupName so arrow keys move the selection. -->
    <Style x:Key="SidebarItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="7,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Grid>
                    <Border x:Name="Lift" CornerRadius="8" Background="{DynamicResource CardBrush}" Margin="0,1,0,-1" Opacity="0">
                        <Border.Effect><BlurEffect Radius="2"/></Border.Effect>
                    </Border>
                    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}"/>
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                        <Setter TargetName="Lift" Property="Background" Value="#14000000"/>
                        <Setter TargetName="Lift" Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarNavItem" TargetType="RadioButton" BasedOn="{StaticResource SidebarItem}">
        <Setter Property="Padding" Value="9,7"/>
    </Style>

    <!-- A card of settings rows or a list (reference .card): card fill, hairline, radius 10, no shadow. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource SkinPanelRadius}"/>
    </Style>
    <!-- A label over a group (reference .lbl): 12 semibold muted, sentence case. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TextBox">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SkinControlRadius}">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>

    <!-- Thin scroll bars: an 6 DIP rounded thumb, no arrows, transparent track. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Thumb"><Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource ControlBorderBrush}"/>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource FaintInkBrush}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Margin="2,2">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
    <Style x:Key="AppContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource AppContextMenuStyle}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}"/>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
</ResourceDictionary>
