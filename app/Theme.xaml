<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fallback palette; AppearanceManager supplies the selected native-app skin. -->
    <Color x:Key="TAccentColor">#B5E879</Color>
    <Color x:Key="TLiveColor">#B5E879</Color>
    <Color x:Key="THoneyColor">#E6BF70</Color>
    <Color x:Key="TDangerColor">#F29A92</Color>
    <Color x:Key="TDotOffColor">#80938D</Color>
    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#101719"/>
    <SolidColorBrush x:Key="ShellPanelBrush" Color="#192326"/>
    <SolidColorBrush x:Key="ShellChipBrush" Color="#223033"/>
    <SolidColorBrush x:Key="ShellHoverBrush" Color="#2A3A3D"/>
    <SolidColorBrush x:Key="ShellSelectedBrush" Color="#293A2C"/>
    <SolidColorBrush x:Key="ShellBorderBrush" Color="#354447"/>
    <SolidColorBrush x:Key="ShellTextBrush" Color="#F1F4F1"/>
    <SolidColorBrush x:Key="ShellMutedBrush" Color="#AFBDB9"/>
    <SolidColorBrush x:Key="ShellHintBrush" Color="#A0B2AB"/>
    <SolidColorBrush x:Key="ShellIconBrush" Color="#AFBDB9"/>
    <SolidColorBrush x:Key="ShellInkBrush" Color="#F1F4F1"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#142014"/>
    <SolidColorBrush x:Key="ShellAccentBrush" Color="#B5E879"/>
    <SolidColorBrush x:Key="TDangerBrush" Color="#412C2C"/>
    <SolidColorBrush x:Key="TDangerInkBrush" Color="#F8B7AD"/>
    <SolidColorBrush x:Key="AWWorkingBrush" Color="#B5E879"/>
    <SolidColorBrush x:Key="AWWaitingBrush" Color="#E6BF70"/>
    <SolidColorBrush x:Key="AWFailedBrush" Color="#F29A92"/>
    <SolidColorBrush x:Key="AWAccentBrush" Color="#B5E879"/>
    <SolidColorBrush x:Key="AWIdleBrush" Color="#80938D"/>

    <SolidColorBrush x:Key="ShellDividerBrush" Color="#354447"/>
    <SolidColorBrush x:Key="ShellChromeBrush" Color="#141E20"/>
    <SolidColorBrush x:Key="ShellCanvasBrush" Color="#101719"/>
    <SolidColorBrush x:Key="ShellPreviewBrush" Color="#111B1D"/>
    <SolidColorBrush x:Key="ShellPreviewOverlayBrush" Color="#101719"/>
    <SolidColorBrush x:Key="ShellAccentHoverBrush" Color="#C8F39A"/>
    <CornerRadius x:Key="SkinControlRadius">6</CornerRadius>
    <CornerRadius x:Key="SkinPanelRadius">9</CornerRadius>
    <CornerRadius x:Key="SkinWindowRadius">8</CornerRadius>
    <FontFamily x:Key="SkinFontFamily">Segoe UI</FontFamily>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource SkinFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}"/>
    </Style>
    <Style x:Key="KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource ShellAccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource SkinControlRadius}" Margin="-3"/></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DeskButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ShellChipBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SkinControlRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DeskButton}"/>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DeskButton}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SkinControlRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellAccentHoverBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource DeskButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Width" Value="38"/><Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style x:Key="MacCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="Foreground" Value="#322B2C"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ContentPresenter x:Name="Glyph" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="1"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="1"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ShellAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TextBox">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SkinControlRadius}">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/></Style>
    <Style x:Key="AppContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}"/>
        <Setter Property="Padding" Value="5"/>
    </Style>
    <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ShellHoverBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource AppContextMenuStyle}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}"/>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ShellChipBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
</ResourceDictionary>
