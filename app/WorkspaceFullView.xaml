<UserControl x:Class="Deskweave.WorkspaceFullView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Deskweave"
             Focusable="False">
    <!-- A workspace in full: header, live screen, "What it did" and "Files". -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- A crescent, stroked like the rest of the icon family rather than pulled from
             Deskweave.AgentWorkspaces's own sprite: the
             small sleep mark and the Sleep control's own icon. -->
        <Geometry x:Key="Icon.Sleep">M2.5,6.5 H7.5 L2.5,12.5 H7.5 M9.5,2.5 H13 L9.5,7 H13</Geometry>
        <Style x:Key="HerePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Working}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HereDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/><Setter Property="Height" Value="7"/>
            <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource AsleepBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Working}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="PillTemplate">
            <Border Style="{StaticResource HerePill}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource HereDot}"/>
                    <TextBlock Text="{Binding Text}" FontSize="12"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="ActRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,6,0,6"/>
        </Style>
        <Style x:Key="FileRow" TargetType="Border" BasedOn="{StaticResource ActRow}">
            <Setter Property="Padding" Value="0,7,0,7"/>
        </Style>
        <DataTemplate x:Key="DidTemplate">
            <Border Style="{StaticResource ActRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11.5" Foreground="{DynamicResource FaintInkBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="{Binding Prefix, Mode=OneWay}"/><Run Text="{Binding Code, Mode=OneWay}"
                             FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                    <!-- 44 wide, 16:10 -->
                    <Border Grid.Column="2" Height="27.5" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}"
                            Visibility="{Binding HasThumb, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="FileTemplate">
            <Border Style="{StaticResource FileRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon13}" Data="{StaticResource Icon.File}"
                          TextElement.Foreground="{DynamicResource MutedInkBrush}" Margin="0,0,10,0"/>
                    <!-- LineHeight is a 1.55 leading (12.5px * 1.55) so the row's pitch comes out right. -->
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" LineHeight="19.4" LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="11.5" Foreground="{DynamicResource FaintInkBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="28,22,28,28" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NameText" Grid.Column="0" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
            <TextBox x:Name="RenameBox" Grid.Column="0" FontSize="21" FontWeight="SemiBold" Padding="4,0" MaxWidth="320"
                      Visibility="Collapsed" VerticalAlignment="Center" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus"/>
            <TextBlock x:Name="PathText" Grid.Column="1" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                       Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" Margin="14,2,0,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding Text, ElementName=PathText}">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy path" Click="CopyPath_Click"/>
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
            <ItemsControl x:Name="HerePanel" Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" ItemTemplate="{StaticResource PillTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <!-- A launch failure (folder, computer) says so briefly here instead of failing silently. -->
            <TextBlock x:Name="HeaderError" Grid.Column="3" FontSize="12" Foreground="{DynamicResource DangerInkBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,10,0"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            <!-- One honest line for what running costs: WorkspaceRuntime.MemoryLoad
                 as-is, no chart and no metric this page invents itself. Only while this workspace's
                 own computer is running, same as the Sleep control beside it. -->
            <TextBlock x:Name="MemoryText" Grid.Column="4" FontSize="12" Foreground="{DynamicResource FaintInkBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,10,0"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            <!-- Sleeps the workspace right now, in one click. Wording carries the
                 whole explanation since a one-click action has no confirmation dialog to say it in;
                 never the word "asleep" itself (it is reserved for the stack, and the UI probe
                 checks this page too). No Take over / Hand back: clicking the
                 screen is still taking over, same as the corner window; this is a different control. -->
            <Button x:Name="SleepButton" Grid.Column="5" Style="{StaticResource IconButton}" Click="Sleep_Click" Margin="0,0,4,0"
                    Visibility="Collapsed"
                    ToolTip="Sleep now. Open apps close; saved files and the last picture stay. The next agent call starts the workspace again."
                    AutomationProperties.Name="Sleep now. Open apps close; saved files and the last picture stay. The next agent call starts the workspace again.">
                <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.Sleep}"/>
            </Button>
            <Button x:Name="FolderButton" Grid.Column="6" Style="{StaticResource IconButton}" Click="Folder_Click" Margin="0,0,10,0"
                    ToolTip="Open folder" AutomationProperties.Name="Open workspace folder">
                <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.Folder}"/>
            </Button>
            <Button x:Name="MoreButton" Grid.Column="7" Style="{StaticResource IconButton}" Click="More_Click"
                    Margin="2,0,0,0" ToolTip="More" AutomationProperties.Name="More workspace actions">
                <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.More}" StrokeThickness="2.4"/>
            </Button>
        </Grid>
        <Border x:Name="ScreenBorder" Grid.Row="2" CornerRadius="{DynamicResource SkinPanelRadius}" BorderThickness="1"
                BorderBrush="{DynamicResource HairlineBrush}" Background="{DynamicResource CardBrush}"
                ClipToBounds="True" VerticalAlignment="Top">
            <Grid x:Name="ScreenLayers">
                <!-- The hand says the picture is the workspace itself and not a screenshot of it,
                     the same as the corner window's. -->
                <Image x:Name="ScreenImage" Stretch="UniformToFill" Cursor="Hand"
                       AutomationProperties.Name="Live workspace screen"/>
                <!-- Builds on the existing "Last seen" pill rather than adding a second,
                     competing indicator. ScreenImage's own Opacity (set in code) dims the picture
                     underneath; this small mark plus the pill's own text say it is asleep while
                     the background stays visible. -->
                <Border x:Name="LastSeenPill" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12" Padding="10,5" CornerRadius="8" Background="{DynamicResource GlassBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon12}" Data="{StaticResource Icon.Sleep}" Margin="0,0,6,0"
                              TextElement.Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LastSeenText" FontSize="12" Foreground="{DynamicResource MutedInkBrush}"/>
                    </StackPanel>
                </Border>
                <!-- Taking over is legible. The owner pressing the live picture
                     takes the wheel and the agent waits, and until this nothing on the page said so.
                     Shown the moment WorkspaceScreenInput's OwnerActed fires and cleared the moment
                     WorkspaceControl.Driving lets go, for any reason (its own timeout, Pause every
                     agent, or the owner leaving some other way). -->
                <Border x:Name="ControlToast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,14" Padding="12,7" CornerRadius="8" Background="{DynamicResource GlassBrush}">
                    <TextBlock x:Name="ControlToastText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <!-- Only this scrolls: the live screen above keeps its own fixed place so the owner's
             pointer never loses it mid-drive. ScrollChanged tracks whether the owner is at the
             bottom so a reload can follow the newest row without fighting a scroll they did themselves. -->
        <ScrollViewer x:Name="ActivityScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="ActivityScroll_ScrollChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="What it did" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="DidList" ItemTemplate="{StaticResource DidTemplate}"/>
                    <TextBlock x:Name="DidEmptyText" Text="Nothing yet" FontSize="12.5"
                               Foreground="{DynamicResource FaintInkBrush}" Visibility="Collapsed" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Files" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="FilesList" ItemTemplate="{StaticResource FileTemplate}"/>
                    <TextBlock x:Name="FilesEmptyText" Text="No files yet" FontSize="12.5"
                               Foreground="{DynamicResource FaintInkBrush}" Visibility="Collapsed" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
