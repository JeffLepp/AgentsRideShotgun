<Window x:Class="Deskweave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Deskweave"
        Title="Deskweave" MinWidth="320" MinHeight="480"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="{DynamicResource SkinFontFamily}" FontSize="13"
        Foreground="{DynamicResource InkBrush}" Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged" IsVisibleChanged="Window_IsVisibleChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- A stack card or row: no chrome of its own, a hover and pressed tint underneath. -->
        <Style x:Key="StackItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tint" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/><Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="{DynamicResource AsleepBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Working}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding NeedsYou}" Value="True"><Setter Property="Fill" Value="{DynamicResource NeedsYouBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AgentTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsYou}" Value="True"><Setter Property="Foreground" Value="{DynamicResource NeedsYouInkBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="WorkingCardTemplate">
            <Button Style="{StaticResource StackItemButton}" Click="WorkingCard_Click" Tag="{Binding Id}" AutomationProperties.Name="{Binding OpenLabel}">
                <StackPanel>
                    <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}"
                            Background="{DynamicResource PreviewBrush}" ClipToBounds="True" Loaded="AspectBorder_Loaded" Tag="0.625">
                        <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                    </Border>
                    <Grid Margin="2,8,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding AgentText}" FontSize="12" Style="{StaticResource AgentTextStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="AsleepRowTemplate">
            <Button Style="{StaticResource StackItemButton}" Click="AsleepRow_Click" Tag="{Binding Id}" AutomationProperties.Name="{Binding OpenLabel}">
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairlineBrush}" Padding="2,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AsleepBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <!-- LineHeight matches the reference's 1.55 leading (13px * 1.55) so the row's pitch matches; WPF's own line box runs shorter. -->
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="12" Foreground="{DynamicResource FaintInkBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SidebarWorkingTemplate">
            <!-- Padding overrides SidebarItem's own (reference .item: padding 7px 8px). -->
            <RadioButton GroupName="HubSidebar" Style="{StaticResource SidebarItem}" Padding="8,7" IsChecked="{Binding Selected, Mode=OneWay}"
                         Checked="SidebarItem_Checked" AutomationProperties.Name="{Binding OpenLabel}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="40" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}"
                            Background="{DynamicResource PreviewBrush}" ClipToBounds="True" Margin="0,0,10,0">
                        <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AgentText}" FontSize="11.5" Style="{StaticResource AgentTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="SidebarAsleepTemplate">
            <RadioButton GroupName="HubSidebar" Style="{StaticResource SidebarItem}" Padding="8,7" IsChecked="{Binding Selected, Mode=OneWay}"
                         Checked="SidebarItem_Checked" AutomationProperties.Name="{Binding OpenLabel}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="40" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}"
                            Background="{DynamicResource PreviewBrush}" ClipToBounds="True" Margin="0,0,10,0" Opacity="0.55">
                        <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SidebarAge}" FontSize="11.5" Foreground="{DynamicResource MutedInkBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource GlassEdgeBrush}" Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Style="{StaticResource MarkIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Deskweave" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="NewButton" Style="{StaticResource IconButton}" Click="New_Click" ToolTip="New workspace · Ctrl+N" AutomationProperties.Name="New workspace">
                        <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.Plus}"/>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click" Margin="8,0,0,0" ToolTip="Settings · Ctrl+," AutomationProperties.Name="Settings">
                        <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.Gear}"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize Deskweave">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource Icon.Min}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore Deskweave">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource Icon.Max}"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close Deskweave">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource Icon.Close}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="StackRoot">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,6,16,16">
                            <Border x:Name="FilterHost" Visibility="Collapsed" Margin="0,0,0,10">
                                <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" AutomationProperties.Name="Filter workspaces by name"/>
                            </Border>
                            <local:TrackedText Text="Working" TextFontSize="11" Margin="2,8,0,0" TextForeground="{DynamicResource FaintInkBrush}"
                                               Visibility="{Binding Items.Count, ElementName=StackWorkingList, Converter={StaticResource CountToVisibility}}"/>
                            <ItemsControl x:Name="StackWorkingList" Margin="0,10,0,0" ItemTemplate="{StaticResource WorkingCardTemplate}"
                                          Visibility="{Binding Items.Count, RelativeSource={RelativeSource Self}, Converter={StaticResource CountToVisibility}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,12"/></Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                            <local:TrackedText Text="Asleep" TextFontSize="11" Margin="2,8,0,6" TextForeground="{DynamicResource FaintInkBrush}"/>
                            <ItemsControl x:Name="StackAsleepList" ItemTemplate="{StaticResource AsleepRowTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="WideRoot" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,10,8,10">
                                <local:TrackedText Text="Working" TextFontSize="11" Margin="2,10,2,4" TextForeground="{DynamicResource FaintInkBrush}"
                                                   Visibility="{Binding Items.Count, ElementName=SidebarWorkingList, Converter={StaticResource CountToVisibility}}"/>
                                <ItemsControl x:Name="SidebarWorkingList" ItemTemplate="{StaticResource SidebarWorkingTemplate}"/>
                                <local:TrackedText Text="Asleep" TextFontSize="11" Margin="2,10,2,4" TextForeground="{DynamicResource FaintInkBrush}"/>
                                <ItemsControl x:Name="SidebarAsleepList" ItemTemplate="{StaticResource SidebarAsleepTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ContentControl x:Name="MainSlot" Grid.Column="1" Focusable="False"/>
                </Grid>

                <ContentControl x:Name="SettingsSlot" Visibility="Collapsed" Focusable="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
