<Window x:Class="Deskweave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Deskweave"
        Title="ARS" MinWidth="320" MinHeight="480"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="{DynamicResource SkinFontFamily}" FontSize="13"
        Foreground="{DynamicResource InkBrush}" Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged" IsVisibleChanged="Window_IsVisibleChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <local:WeekBarHeight x:Key="WeekBarHeight"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- "Zz", since the crescent now means night in the title bar. Same as the
             workspace page's own Icon.Sleep (WorkspaceFullView.xaml): the
             card/row Sleep control and this window are separate resource scopes,
             so it is defined once per file rather than pulled from Deskweave.AgentWorkspaces's sprite. -->
        <Geometry x:Key="Icon.Sleep">M2.5,6.5 H7.5 L2.5,12.5 H7.5 M9.5,2.5 H13 L9.5,7 H13</Geometry>
        <!-- A toothed gear. The engine's Icon.Gear is a ring of short strokes that reads as a sun at
             15 DIP, and the sun now means day. -->
        <Geometry x:Key="Icon.Cog">M12.83,6.71 L14.60,6.84 L14.60,9.16 L12.83,9.29 L12.33,10.50 L13.49,11.84 L11.84,13.49 L10.50,12.33 L9.29,12.83 L9.16,14.60 L6.84,14.60 L6.71,12.83 L5.50,12.33 L4.16,13.49 L2.51,11.84 L3.67,10.50 L3.17,9.29 L1.40,9.16 L1.40,6.84 L3.17,6.71 L3.67,5.50 L2.51,4.16 L4.16,2.51 L5.50,3.67 L6.71,3.17 L6.84,1.40 L9.16,1.40 L9.29,3.17 L10.50,3.67 L11.84,2.51 L13.49,4.16 L12.33,5.50 Z M10.2,8 A2.2,2.2 0 1 1 5.8,8 A2.2,2.2 0 1 1 10.2,8 Z</Geometry>
        <Geometry x:Key="Icon.Search">M10.5,10.5 L14,14 M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7</Geometry>

        <!-- A stack card or row: no chrome of its own, a hover and pressed tint underneath. -->
        <Style x:Key="StackItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tint" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/><Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="{DynamicResource AsleepBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Working}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                <!-- Live: the dot breathes while the card says what the
                     agent is doing this moment. -->
                <DataTrigger Binding="{Binding Live}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Breathe">
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Breathe"/></DataTrigger.ExitActions>
                </DataTrigger>
                <!-- Idle wins over Working: running with nobody home reads the same grey as Recent's
                     dot rather than the accent it wore whether it was mid-task or
                     had done nothing for twenty minutes. NeedsYou (declared after) still wins over both. -->
                <DataTrigger Binding="{Binding Idle}" Value="True"><Setter Property="Fill" Value="{DynamicResource AsleepBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding NeedsYou}" Value="True"><Setter Property="Fill" Value="{DynamicResource NeedsYouBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AgentTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsYou}" Value="True"><Setter Property="Foreground" Value="{DynamicResource NeedsYouInkBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A working workspace: its screen across the whole card, big
             enough to watch, with the name and what the agent is doing under it. -->
        <DataTemplate x:Key="WorkingCardTemplate">
            <StackPanel Margin="0,3,0,5">
                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}" Background="{DynamicResource CardBrush}">
                    <Border.ContextMenu><ContextMenu><MenuItem Header="Stop this workspace" Click="StopMenu_Click" Tag="{Binding Id}"/></ContextMenu></Border.ContextMenu>
                    <Grid>
                        <Button Style="{StaticResource StackItemButton}" Click="WorkingCard_Click" Tag="{Binding Id}"
                                ToolTip="{Binding PreviewLabel}" AutomationProperties.Name="{Binding PreviewLabel}">
                            <StackPanel Margin="7,7,7,8">
                                <Border Tag="0.625" Loaded="AspectBorder_Loaded" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}"
                                        Background="{DynamicResource PreviewBrush}" ClipToBounds="True">
                                    <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                                </Border>
                                <Grid Margin="3,8,34,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Margin="3,4,34,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AgentText}" FontSize="12" Style="{StaticResource AgentTextStyle}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding AgentText}"/>
                                </Grid>
                            </StackPanel>
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Margin="0,0,8,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource IconButton}"
                                Click="SleepCard_Click" Tag="{Binding Id}" ToolTip="{Binding SleepLabel}" AutomationProperties.Name="{Binding SleepLabel}">
                            <Path Style="{StaticResource Icon13}" Data="{StaticResource Icon.Sleep}"/>
                        </Button>
                    </Grid>
                </Border>
                <local:WorkspaceInlineView Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}" ShowMore="Inline_ShowMore"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AsleepRowTemplate">
            <StackPanel>
            <Button Style="{StaticResource StackItemButton}" Click="AsleepRow_Click" Tag="{Binding Id}" ToolTip="{Binding PreviewLabel}" AutomationProperties.Name="{Binding PreviewLabel}">
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairlineBrush}" Padding="2,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AsleepBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <!-- LineHeight is a 1.55 leading (13px * 1.55) so the row's pitch comes out right; WPF's own line box runs shorter. -->
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- The week's activity, oldest to today. -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Week}" Height="12" Margin="10,0,0,0" VerticalAlignment="Center" Focusable="False" IsTabStop="False"
                                      AutomationProperties.Name="Activity this week">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Rectangle Width="3" Margin="1,0,0,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" Opacity="0.55"
                                           Height="{Binding Converter={StaticResource WeekBarHeight}}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="3" Text="{Binding Age}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <Path Grid.Column="4" Data="M2,4 L5,7 L8,4" Stroke="{DynamicResource MutedInkBrush}" StrokeThickness="1" Width="10" Height="10" Margin="8,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding Expanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                    </Grid>
                </Border>
            </Button>
            <local:WorkspaceInlineView Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}" ShowMore="Inline_ShowMore"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SidebarWorkingTemplate">
            <!-- Padding overrides SidebarItem's own (padding 7px 8px). -->
            <RadioButton GroupName="HubSidebar" Style="{StaticResource SidebarItem}" Padding="8,7" IsChecked="{Binding Selected, Mode=OneWay}"
                         Checked="SidebarItem_Checked" AutomationProperties.Name="{Binding OpenLabel}">
                <RadioButton.ContextMenu><ContextMenu><MenuItem Header="Stop this workspace" Click="StopMenu_Click" Tag="{Binding Id}"/></ContextMenu></RadioButton.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="40" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}"
                            Background="{DynamicResource PreviewBrush}" ClipToBounds="True" Margin="0,0,10,0">
                        <!-- ClipToBounds clips to the rectangular bounds only, not the rounded corners, so the
                             image's square corners would otherwise cover the radius and hide the hairline there. -->
                        <Border.Clip><RectangleGeometry Rect="0,0,64,40" RadiusX="5" RadiusY="5"/></Border.Clip>
                        <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding AgentText}" FontSize="12" Style="{StaticResource AgentTextStyle}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding AgentText}"/>
                        </Grid>
                    </StackPanel>
                    <!-- Same one-click Sleep control as the stack's card, sized for
                         this row instead of the wider card. -->
                    <Button Grid.Column="2" Width="22" Height="22" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                            Click="SleepCard_Click" Tag="{Binding Id}" ToolTip="{Binding SleepLabel}" AutomationProperties.Name="{Binding SleepLabel}">
                        <Path Style="{StaticResource Icon13}" Data="{StaticResource Icon.Sleep}"/>
                    </Button>
                </Grid>
            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="SidebarAsleepTemplate">
            <RadioButton GroupName="HubSidebar" Style="{StaticResource SidebarItem}" Padding="8,9" IsChecked="{Binding Selected, Mode=OneWay}"
                         Checked="SidebarItem_Checked" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding OpenLabel}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AsleepBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource GlassEdgeBrush}" Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Path x:Name="TitleMark" Style="{StaticResource MarkIcon}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                    <!-- Settings in the card: back takes the mark's place. -->
                    <Button x:Name="CardBackButton" Visibility="Collapsed" Margin="-9,0,-4,0" Style="{StaticResource IconButton}" Click="CardBack_Click"
                            ToolTip="Back" AutomationProperties.Name="Back" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.Back}"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="ARS" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BackButton" Visibility="Collapsed" Style="{StaticResource IconButton}" Click="Back_Click" ToolTip="Back to workspaces" AutomationProperties.Name="Back to workspaces">
                        <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.Back}"/>
                    </Button>
                    <!-- No new-workspace button: workspaces make themselves. -->
                    <Button x:Name="FilterButton" Width="30" Style="{StaticResource IconButton}" Click="Filter_Click" ToolTip="Find a workspace" AutomationProperties.Name="Find a workspace">
                        <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.Search}"/>
                    </Button>
                    <Button x:Name="ThemeButton" Width="30" Style="{StaticResource IconButton}" Click="Theme_Click" AutomationProperties.Name="Switch day and night">
                        <local:DayNightIcon x:Name="ThemeIcon"/>
                    </Button>
                    <Button x:Name="SettingsButton" Width="30" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings">
                        <Path Style="{StaticResource Icon15}" Data="{StaticResource Icon.Cog}"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize ARS">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource Icon.Min}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore ARS">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource Icon.Max}"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close ARS">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource Icon.Close}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid x:Name="StackRoot">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <ScrollViewer x:Name="StackScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,6,16,16">
                            <!-- Today: what the agents got done today, from the
                                 workspaces' own action logs. -->
                            <UniformGrid x:Name="TodayStrip" Columns="3" Margin="0,2,0,6">
                                <UniformGrid.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Padding" Value="10,6,8,7"/>
                                    </Style>
                                </UniformGrid.Resources>
                                <Border Margin="0,0,4,0"><StackPanel>
                                    <TextBlock x:Name="TodayActions" Text="0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock x:Name="TodayActionsLabel" Text="actions today" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel></Border>
                                <Border Margin="2,0,2,0"><StackPanel>
                                    <TextBlock x:Name="TodayWorkspaces" Text="0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock x:Name="TodayWorkspacesLabel" Text="workspaces" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel></Border>
                                <Border Margin="4,0,0,0"><StackPanel>
                                    <TextBlock x:Name="TodayCommands" Text="0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock x:Name="TodayCommandsLabel" Text="commands" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel></Border>
                            </UniformGrid>
                            <Border x:Name="FilterHost" Visibility="Collapsed" Margin="0,0,0,10">
                                <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" AutomationProperties.Name="Filter workspaces by name"/>
                            </Border>
                            <TextBlock x:Name="FilterEmptyText" Text="No matching workspaces" Foreground="{DynamicResource MutedInkBrush}" Margin="2,8" Visibility="Collapsed"/>
                            <TextBlock Text="Working" FontSize="12" FontWeight="SemiBold" Margin="2,8,0,2" Foreground="{DynamicResource MutedInkBrush}"
                                               Visibility="{Binding Items.Count, ElementName=StackWorkingList, Converter={StaticResource CountToVisibility}}"/>
                            <ItemsControl x:Name="StackWorkingList" Margin="0,4,0,0" ItemTemplate="{StaticResource WorkingCardTemplate}"
                                          Visibility="{Binding Items.Count, RelativeSource={RelativeSource Self}, Converter={StaticResource CountToVisibility}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Recent" FontSize="12" FontWeight="SemiBold" Margin="2,14,0,6" Foreground="{DynamicResource MutedInkBrush}"
                                       Visibility="{Binding Items.Count, ElementName=StackAsleepList, Converter={StaticResource CountToVisibility}}"/>
                            <ItemsControl x:Name="StackAsleepList" ItemTemplate="{StaticResource AsleepRowTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="WideRoot" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,10,8,10">
                                <TextBlock Text="Working" FontSize="12" FontWeight="SemiBold" Margin="8,7,2,7" Foreground="{DynamicResource MutedInkBrush}"
                                                   Visibility="{Binding Items.Count, ElementName=SidebarWorkingList, Converter={StaticResource CountToVisibility}}"/>
                                <!-- ItemContainerStyle's bottom margin: the row template alone renders a shade short
                                     per row, and the drift adds up at the bottom of a long list. -->
                                <ItemsControl x:Name="SidebarWorkingList" ItemTemplate="{StaticResource SidebarWorkingTemplate}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,2"/></Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                                <TextBlock Text="Recent" FontSize="12" FontWeight="SemiBold" Margin="8,14,2,7" Foreground="{DynamicResource MutedInkBrush}"
                                           Visibility="{Binding Items.Count, ElementName=SidebarAsleepList, Converter={StaticResource CountToVisibility}}"/>
                                <ItemsControl x:Name="SidebarAsleepList" ItemTemplate="{StaticResource SidebarAsleepTemplate}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,2"/></Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ContentControl x:Name="MainSlot" Grid.Column="1" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>

                <ContentControl x:Name="CardSettingsSlot" Visibility="Collapsed" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.RenderTransform><TranslateTransform/></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SettingsSlot" Visibility="Collapsed" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Border>
</Window>
