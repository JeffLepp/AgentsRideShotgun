<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Deskweave</AssemblyName>
    <RootNamespace>Deskweave</RootNamespace>
    <AssemblyTitle>Deskweave</AssemblyTitle>
    <Description>Local Windows workspaces for your agents.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Deskweave.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <StartupObject>Deskweave.Program</StartupObject>
  </PropertyGroup>
  <!-- App.xaml compiles as a Page so the SDK does not generate a Main next to Program.cs. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../engine/Deskweave.Engine.csproj" />
    <InternalsVisibleTo Include="Deskweave.Probe" />
    <InternalsVisibleTo Include="Deskweave.UiProbe" />
    <Resource Include="Assets/Deskweave.ico" />
    <Resource Include="Assets/ThirdPartyNotices.txt" />
    <Resource Include="Assets/first-run-preview.png" />
  </ItemGroup>
</Project>
