<UserControl x:Class="Deskweave.WorkspaceInlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" HorizontalContentAlignment="Stretch">
    <StackPanel Margin="0,2,0,12" MaxWidth="420" HorizontalAlignment="Stretch">
        <Border x:Name="Frame" Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="1" CornerRadius="5" ClipToBounds="True" SizeChanged="Frame_SizeChanged">
            <Grid>
                <Image x:Name="Screen" Source="{Binding Preview}" Stretch="Uniform" IsHitTestVisible="False"
                       AutomationProperties.Name="Workspace screen"/>
                <TextBlock x:Name="EmptyText" Text="No picture yet" FontSize="12" Foreground="{DynamicResource MutedInkBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Margin="2,7,2,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StateText" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="ReturnButton" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Give back" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="Return_Click" ToolTip="Return control to the agent" AutomationProperties.Name="Return control to the agent"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Content="Start screen"
                    Click="Start_Click" ToolTip="Start a new screen. Previous apps are not restored."/>
            <Button x:Name="MoreButton" Grid.Column="1" Style="{StaticResource QuietButton}" Content="Show more" Click="More_Click"
                    ToolTip="Open this workspace's full screen, history and files"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="2,6,2,0" FontSize="12" Foreground="{DynamicResource DangerInkBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
