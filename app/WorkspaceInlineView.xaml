<UserControl x:Class="Deskweave.WorkspaceInlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Quiet outlined toggles under the screen. -->
        <Style x:Key="PanelToggle" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- One line per step: the strip is narrow, so a long command trims instead of wrapping. -->
        <DataTemplate x:Key="StepTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Day}" Style="{StaticResource DayLabel}" Margin="0,6,0,2"
                           Visibility="{Binding HasDay, Converter={StaticResource BoolToVis}}"/>
                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource FaintInkBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Mark}" Style="{StaticResource RunMark}"/>
                        <TextBlock Grid.Column="2" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <Run Text="{Binding Prefix, Mode=OneWay}"/><Run Text="{Binding Code, Mode=OneWay}"
                                 FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource AccentBrush}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="3" Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource FaintInkBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="0,6,0,12" MaxWidth="420" HorizontalAlignment="Stretch">
        <Border x:Name="Frame" Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="1" CornerRadius="5" ClipToBounds="True" SizeChanged="Frame_SizeChanged"
                PreviewMouseLeftButtonDown="Frame_PreviewMouseLeftButtonDown">
            <Grid>
                <Image x:Name="Screen" Source="{Binding Preview}" Stretch="Uniform" IsHitTestVisible="False"
                       AutomationProperties.Name="Workspace screen"/>
                <TextBlock x:Name="EmptyText" Text="No picture yet" FontSize="12" Foreground="{DynamicResource MutedInkBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <!-- Only while stopped: the whole picture is one real button that starts the screen. -->
                <Button x:Name="StartOverlay" Visibility="Collapsed" Click="Start_Click" Cursor="Hand"
                        ToolTip="Start screen" FocusVisualStyle="{StaticResource KeyboardFocus}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <!-- A working card puts its name here, under the screen as when it is closed. -->
        <ContentPresenter Content="{Binding Caption, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Grid Margin="2,7,2,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StateText" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="ReturnButton" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Give back" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="Return_Click" ToolTip="Return control to the agent" AutomationProperties.Name="Return control to the agent"/>
        </Grid>
        <!-- Logs and files stay folded until asked for, so opening a card shows only its screen. -->
        <UniformGrid Columns="2" Margin="0,4,0,0">
            <Button x:Name="ShowLogsButton" Style="{StaticResource PanelToggle}" Margin="0,0,3,0" Content="Show logs" Click="ShowLogs_Click"/>
            <Button x:Name="ShowFilesButton" Style="{StaticResource PanelToggle}" Margin="3,0,0,0" Content="Show files" Click="ShowFiles_Click"/>
        </UniformGrid>
        <ItemsControl x:Name="FileList" Focusable="False" Visibility="Collapsed" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource QuietButton}" Padding="2,6" FontWeight="Normal" HorizontalContentAlignment="Stretch" Click="File_Click" Tag="{Binding Path}"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
                            ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Icon12}" Data="{StaticResource Icon.File}" Margin="0,0,8,0"
                                  TextElement.Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="11" Foreground="{DynamicResource FaintInkBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="StepList" Focusable="False" Visibility="Collapsed" Margin="0,2,0,0" ItemTemplate="{StaticResource StepTemplate}"/>
        <TextBlock x:Name="NothingText" Visibility="Collapsed" Margin="2,8,2,0" FontSize="12" Foreground="{DynamicResource FaintInkBrush}"/>
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="2,6,2,0" FontSize="12" Foreground="{DynamicResource DangerInkBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
